OPS_ENVIRONMENT=development
OPS_SERVICE_NAME=opsdesk
OPS_VERSION=0.1.0
OPS_LOG_LEVEL=INFO
OPS_DATABASE_URL=postgresql+psycopg://opsdesk:opsdesk_dev_only@localhost:5433/opsdesk_db
OPS_CSRF_SECRET_KEY=replace-with-a-random-development-secret
OPS_SESSION_COOKIE_SECURE=false
OPS_SESSION_ABSOLUTE_MINUTES=480
OPS_SESSION_IDLE_MINUTES=60
OPS_ENABLE_DEV_SEED=false

# Required only when OPS_ENABLE_DEV_SEED=true in development.
OPS_SEED_USER_PASSWORD=
OPS_SEED_AGENT_PASSWORD=
OPS_SEED_ADMIN_PASSWORD=
