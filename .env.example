OPS_ENVIRONMENT=development
OPS_SERVICE_NAME=opsdesk
OPS_VERSION=0.3.0
OPS_LOG_LEVEL=INFO
OPS_DATABASE_URL=postgresql+psycopg://opsdesk:opsdesk_dev_only@localhost:5433/opsdesk_db
OPS_CSRF_SECRET_KEY=replace-with-a-random-development-secret
OPS_SESSION_COOKIE_SECURE=false
OPS_SESSION_ABSOLUTE_MINUTES=480
OPS_SESSION_IDLE_MINUTES=60
OPS_ENABLE_DEV_SEED=false
OPS_OTEL_ENABLED=false
OPS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OPS_OTEL_EXPORT_TIMEOUT_SECONDS=2
OPS_OTEL_SAMPLE_RATIO=1.0
OPS_ENABLE_CONTROLLED_FAILURES=false
OPS_CONTROLLED_FAILURE_MAX_DELAY_MS=2000
OPS_TRAFFIC_ENABLED=false
OPS_TRAFFIC_BASE_URL=http://localhost:8000
OPS_TRAFFIC_RATE_PER_SECOND=0.2
OPS_TRAFFIC_CONCURRENCY=2
OPS_TRAFFIC_DURATION_SECONDS=60
OPS_TRAFFIC_REQUEST_TIMEOUT_SECONDS=5
OPS_TRAFFIC_CONTROLLED_OUTCOMES=true
OPS_TRAFFIC_CONTROLLED_FAILURES=false

# Required only when OPS_ENABLE_DEV_SEED=true in development.
OPS_SEED_USER_PASSWORD=
OPS_SEED_AGENT_PASSWORD=
OPS_SEED_ADMIN_PASSWORD=
