OPS_ENVIRONMENT=development
OPS_SERVICE_NAME=opsdesk
OPS_VERSION=0.5.0
OPS_LOG_LEVEL=INFO
OPS_DATABASE_URL=postgresql+psycopg://opsdesk:opsdesk_dev_only@localhost:5433/opsdesk_db
OPS_DATABASE_POOL_SIZE=5
OPS_DATABASE_MAX_OVERFLOW=5
OPS_DATABASE_POOL_TIMEOUT_SECONDS=30
OPS_DATABASE_POOL_RECYCLE_SECONDS=1800
OPS_DATABASE_CONNECT_TIMEOUT_SECONDS=3
OPS_CSRF_SECRET_KEY=replace-with-a-random-development-secret
OPS_SESSION_COOKIE_SECURE=false
OPS_SESSION_ABSOLUTE_MINUTES=480
OPS_SESSION_IDLE_MINUTES=60
OPS_ENABLE_DEV_SEED=false
OPS_OTEL_ENABLED=false
OPS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OPS_OTEL_EXPORT_TIMEOUT_SECONDS=2
OPS_OTEL_SAMPLE_RATIO=1.0
OPS_ENABLE_CONTROLLED_FAILURES=false
OPS_CONTROLLED_FAILURE_MAX_DELAY_MS=2000
OPS_TRAFFIC_ENABLED=false
OPS_TRAFFIC_BASE_URL=http://localhost:8000
OPS_TRAFFIC_RATE_PER_SECOND=0.2
OPS_TRAFFIC_CONCURRENCY=2
OPS_TRAFFIC_DURATION_SECONDS=60
OPS_TRAFFIC_REQUEST_TIMEOUT_SECONDS=5
OPS_TRAFFIC_CONTROLLED_OUTCOMES=true
OPS_TRAFFIC_CONTROLLED_FAILURES=false

# Optional Phase 7 workflow. Keep disabled unless a queue and Agent are deployed.
OPS_AI_ENABLED=false
OPS_AI_DISPATCH_MODE=disabled
OPS_AI_QUEUE_URL=
OPS_AI_INTERNAL_TOKEN=replace-with-a-random-agent-service-token
OPS_AI_WORKFLOW_DEADLINE_SECONDS=120
OPS_AI_OUTBOX_POLL_SECONDS=2

# Separate CPU Agent settings. The Agent must not receive OPS_DATABASE_URL.
OPS_AGENT_QUEUE_URL=
OPS_AGENT_OPSDESK_BASE_URL=http://localhost:8000
OPS_AGENT_SERVICE_TOKEN=replace-with-the-same-agent-service-token
OPS_AGENT_REQUEST_TIMEOUT_SECONDS=5
OPS_AGENT_TOTAL_DEADLINE_SECONDS=120
OPS_AGENT_MAX_STEPS=3
OPS_AGENT_TOKEN_BUDGET=2000
OPS_AGENT_LLM_GATEWAY_ENABLED=false
OPS_AGENT_LLM_GATEWAY_BASE_URL=
OPS_AGENT_LLM_GATEWAY_API_KEY=
OPS_AGENT_LLM_GATEWAY_API_KEY_SECRET_ARN=
OPS_AGENT_LLM_GATEWAY_CACHE_POLICY=private
OPS_AGENT_LLM_GATEWAY_MAX_TOKENS=512
OPS_AGENT_LLM_GATEWAY_TEMPERATURE=0.2
OPS_AGENT_RAG_ENABLED=false
OPS_AGENT_RAG_BASE_URL=
OPS_AGENT_RAG_API_KEY=
OPS_AGENT_RAG_API_KEY_SECRET_ARN=
OPS_AGENT_RAG_SOURCE_IDS=[]
OPS_AGENT_RAG_MAX_CHUNKS=5

# Required only when OPS_ENABLE_DEV_SEED=true in development.
OPS_SEED_USER_PASSWORD=
OPS_SEED_AGENT_PASSWORD=
OPS_SEED_ADMIN_PASSWORD=
